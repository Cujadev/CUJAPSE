<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="rootPane"
            prefHeight="670" prefWidth="700"
            stylesheets="@../visualResources/paletaDeColores/estilos.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="interfaz.controllers.MenuInicioController">

    <children>

        <!-- ⭐ CONTENEDOR PRINCIPAL -->
        <StackPane fx:id="scalableRoot"
                   AnchorPane.topAnchor="0"
                   AnchorPane.bottomAnchor="0"
                   AnchorPane.leftAnchor="0"
                   AnchorPane.rightAnchor="0">

            <!-- ⭐ FONDO -->
            <ImageView fx:id="backgroundImage"
                       preserveRatio="false"
                       pickOnBounds="true">
                <image>
                    <Image url="@../visualResources/escenarios/fondoPantallaInicio.png"/>
                </image>
            </ImageView>

            <Button fx:id="btnFullscreen"
                    text="Pantalla Completa"
                    styleClass="btn-menu-principal"
                    onAction="#onToggleFullscreen"
                    StackPane.alignment="TOP_RIGHT"/>


            <!-- ⭐ MENÚ DEBAJO DEL LOGO -->
            <VBox fx:id="vboxMenu"
                  alignment="TOP_CENTER"
                  spacing="25"
                  prefWidth="229" prefHeight="190"
                  StackPane.alignment="TOP_CENTER">

                <Button fx:id="btnNuevaPartida"
                        onAction="#onNuevaPartidaClick"
                        prefWidth="200" prefHeight="45"
                        styleClass="btn-menu-principal"
                        text="Nueva Partida"/>

                <Button fx:id="btnCargarPartida"
                        onAction="#onCargarPartidaClick"
                        prefWidth="200" prefHeight="45"
                        styleClass="btn-menu-principal"
                        text="Cargar Partida"/>

                <Button fx:id="btnSalir"
                        onAction="#onSalirClick"
                        prefWidth="200" prefHeight="45"
                        styleClass="btn-menu-principal"
                        text="Salir del Juego"/>

            </VBox>

        </StackPane>

    </children>
</AnchorPane>
