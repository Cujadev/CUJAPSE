<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane"
            styleClass="root-principal"
            stylesheets="@../visualResources/paletaDeColores/estilos.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="interfaz.controllers.PrincipalController">

    <!-- ========================================================= -->
    <!-- TOP: MENÚ SUPERIOR -->
    <!-- ========================================================= -->
    <top>
        <HBox fx:id="menuSuperior"
              alignment="CENTER_LEFT"
              prefHeight="45"
              styleClass="menu-superior">

            <padding>
                <Insets left="15" right="15"/>
            </padding>

            <MenuBar fx:id="menuBar" styleClass="menu-bar">
                <menus>
                    <Menu fx:id="menuOpciones">
                        <graphic>
                            <ImageView fitHeight="22" fitWidth="22">
                                <image><Image url="@../visualResources/iconos/menu.png"/></image>
                            </ImageView>
                        </graphic>
                        <items>
                            <MenuItem fx:id="menuSalirMenu"
                                      text="Salir al menú principal"
                                      onAction="#onSalirMenuClick"/>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <Pane HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <!-- ========================================================= -->
    <!-- LEFT: PANEL IZQUIERDO -->
    <!-- ========================================================= -->
    <left>
        <VBox fx:id="panelIzquierdo"
              minWidth="70"
              maxWidth="70"
              styleClass="panel-izquierdo"/>
    </left>

    <!-- ========================================================= -->
    <!-- RIGHT: ÁRBOL DE DECISIONES -->
    <!-- ========================================================= -->
    <right>
        <VBox fx:id="panelArbol"
              spacing="10"
              minWidth="270"
              maxWidth="270"
              styleClass="panel-arbol">

            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

            <Label styleClass="titulo-arbol" text="Árbol de decisiones"/>

            <TreeView fx:id="treeViewDecisiones" VBox.vgrow="ALWAYS"/>
        </VBox>
    </right>

    <!-- ========================================================= -->
    <!-- CENTER: CHAT + DECISIONES -->
    <!-- ========================================================= -->
    <center>
        <VBox fx:id="panelChat"
              spacing="0"
              VBox.vgrow="ALWAYS">

            <!-- =================== -->
            <!-- BARRA DE ESTADÍSTICAS -->
            <!-- =================== -->
            <HBox fx:id="statsTopBar"
                  alignment="CENTER_LEFT"
                  prefHeight="55"
                  spacing="25"
                  styleClass="stats-bar">

                <padding><Insets left="25"/></padding>

                <HBox fx:id="labelDinero" alignment="CENTER" spacing="8" styleClass="stat-box">
                    <ImageView fitHeight="26" fitWidth="26">
                        <image><Image url="@../visualResources/estadisticas/dinero.png"/></image>
                    </ImageView>
                    <Label fx:id="labelDineroTexto" styleClass="stat-label" text="0%"/>
                </HBox>

                <HBox fx:id="labelCafeina" alignment="CENTER" spacing="8" styleClass="stat-box">
                    <ImageView fitHeight="26" fitWidth="26">
                        <image><Image url="@../visualResources/estadisticas/cafeina.png"/></image>
                    </ImageView>
                    <Label fx:id="labelCafeinaTexto" styleClass="stat-label" text="0%"/>
                </HBox>

                <HBox fx:id="labelPopularidad" alignment="CENTER" spacing="8" styleClass="stat-box">
                    <ImageView fitHeight="26" fitWidth="26">
                        <image><Image url="@../visualResources/estadisticas/popularidad.png"/></image>
                    </ImageView>
                    <Label fx:id="labelPopularidadTexto" styleClass="stat-label" text="0%"/>
                </HBox>

                <HBox fx:id="labelEstudios" alignment="CENTER" spacing="8" styleClass="stat-box">
                    <ImageView fitHeight="26" fitWidth="26">
                        <image><Image url="@../visualResources/estadisticas/estudios.png"/></image>
                    </ImageView>
                    <Label fx:id="labelEstudiosTexto" styleClass="stat-label" text="0%"/>
                </HBox>

                <Pane HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- =================== -->
            <!-- CHAT -->
            <!-- =================== -->
            <ScrollPane fx:id="scrollChat"
                        fitToWidth="true"
                        styleClass="scroll-chat"
                        VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="vboxMensajes"
                          spacing="15"
                          styleClass="panel-chat"
                          VBox.vgrow="ALWAYS">
                        <padding><Insets bottom="15" left="20" right="20" top="15"/></padding>
                    </VBox>
                </content>
            </ScrollPane>

            <!-- =================== -->
            <!-- DECISIONES -->
            <!-- =================== -->
            <VBox fx:id="decisionArea"
                  spacing="14"
                  styleClass="decision-panel"
                  alignment="CENTER">

                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <!-- ÓVALO DEL MENSAJE + ENVIAR -->
                <HBox alignment="CENTER_LEFT"
                      spacing="10"
                      styleClass="decision-message-container"
                      HBox.hgrow="ALWAYS">

                    <Label fx:id="labelDecisionMessage"
                           styleClass="decision-message-text"
                           wrapText="true"
                           HBox.hgrow="ALWAYS"/>

                    <Button fx:id="btnSendDecision"
                            disable="true"
                            visible="false"
                            onAction="#onSendDecisionClick"
                            styleClass="btn-send-decision-inside">
                        <graphic>
                            <ImageView fitHeight="28" fitWidth="28" preserveRatio="true">
                                <image><Image url="@../visualResources/iconos/enviar.png"/></image>
                            </ImageView>
                        </graphic>
                    </Button>
                </HBox>

                <!-- BOTONES -->
                <HBox alignment="CENTER" spacing="40">

                    <Button fx:id="btnOptionYes"
                            onAction="#onOptionYesClick"
                            minWidth="120"
                            styleClass="decision-btn"
                            text="Sí"/>

                    <Button fx:id="btnOptionNo"
                            onAction="#onOptionNoClick"
                            minWidth="120"
                            styleClass="decision-btn"
                            text="No"/>

                    <Button fx:id="btnContinuar"
                            text="Continuar"
                            minWidth="140"
                            styleClass="decision-btn"
                            visible="false"
                            managed="false"
                            onAction="#onContinuarClick"/>
                </HBox>

            </VBox>


        </VBox>
    </center>

</BorderPane>
