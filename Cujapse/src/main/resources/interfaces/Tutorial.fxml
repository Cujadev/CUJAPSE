<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="564.0" prefWidth="923.0"
            styleClass="root"
            stylesheets="@../visualResources/paletaDeColores/estilos.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="interfaz.controllers.TutorialController">

    <children>

        <!-- Fondo del tutorial -->
        <ImageView fitHeight="564" fitWidth="923" preserveRatio="false"
                   AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
                   AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
            <image>
                <Image url="@../visualResources/escenarios/fondoTutorial.png"/>
            </image>
        </ImageView>

        <!-- Personaje del tutorial -->
        <ImageView fitHeight="379" fitWidth="277" layoutX="14" layoutY="69" preserveRatio="true">
            <image>
                <Image url="@../visualResources/personajes/Omar_tutorial.png"/>
            </image>
        </ImageView>

        <!-- Caja de diálogo inferior -->
        <AnchorPane fx:id="dialogBox"
                    opacity="0.94"
                    prefHeight="120" prefWidth="895"
                    styleClass="dialogo-caja"
                    AnchorPane.bottomAnchor="10"
                    AnchorPane.leftAnchor="10"
                    AnchorPane.rightAnchor="10">

            <children>
                <VBox alignment="TOP_LEFT"
                      AnchorPane.topAnchor="10"
                      AnchorPane.bottomAnchor="10"
                      AnchorPane.leftAnchor="15"
                      AnchorPane.rightAnchor="15"
                      spacing="8">

                    <!-- Texto del diálogo -->
                    <Label fx:id="labelDialogo"
                           wrapText="true"
                           prefHeight="80"
                           styleClass="tutorial-text"/>

                </VBox>

                <!-- Botón continuar (flecha) -->
                <Button fx:id="btnContinuar"
                        text="▶"
                        onAction="#onContinuarClick"
                        prefHeight="55" prefWidth="40"
                        styleClass="btn-continue-arrow"
                        AnchorPane.bottomAnchor="10"
                        AnchorPane.rightAnchor="15"/>
            </children>

        </AnchorPane>

    </children>
</AnchorPane>
